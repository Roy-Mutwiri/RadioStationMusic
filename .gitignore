# --- OS / editor
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json.example

# Phase 7 engineering artefacts: real generated audio, hundreds of MB.
# The measurements derived from them live in docs/status/PHASE_7_REPORT.md; the audio
# itself is reproducible from the scripts and does not belong in version control.
/artifacts/

# --- Desktop launcher: shortcuts are per-machine. The built exe IS committed, at the root.
*.lnk
