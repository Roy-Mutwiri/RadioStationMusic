# ============================================================================
#  TRADE FIX RADIO — environment template
#
#  Copy to `.env` and edit. `.env` is git-ignored and MUST NOT be committed.
#  Every value here overrides the matching key in config/*.yaml.
#  Nesting uses a double underscore:  TRADEFIX_RADIO__TARGET_BUFFER_MINUTES
#
#  Secrets live ONLY here or in the OS secret store — never in YAML, never in
#  source (§68). The API never returns a stored secret unmasked.
# ============================================================================

# --- Run mode: development | simulation | production  (§72)
TRADEFIX_MODE=development

# --- Paths (absolute recommended on Windows)
TRADEFIX_PATHS__DATA_DIR=D:/.Music/data
TRADEFIX_PATHS__GENERATED_DIR=D:/.Music/generated
TRADEFIX_PATHS__EMERGENCY_DIR=D:/.Music/emergency
TRADEFIX_PATHS__LOG_DIR=D:/.Music/logs

# --- Database (ADR-05)
# SQLite (default, no server needed):
TRADEFIX_DATABASE__URL=sqlite+aiosqlite:///D:/.Music/data/tradefix.db
# PostgreSQL (optional; requires the `postgres` extra):
# TRADEFIX_DATABASE__URL=postgresql+asyncpg://tradefix:CHANGE_ME@localhost:5432/tradefix

# --- Market feed (ADR-03)
# simulated | metatrader5 | rest | replay
TRADEFIX_MARKET__FEED=simulated
TRADEFIX_MARKET__SYMBOL=XAUUSD
# Broker symbol aliases to try when the exact symbol is absent (gold is named
# inconsistently across brokers). Comma-separated, tried in order.
TRADEFIX_MARKET__SYMBOL_ALIASES=XAUUSD,XAUUSD.m,XAUUSDm,GOLD,GOLD.spot,XAUUSD_

# REST feed only — leave blank unless TRADEFIX_MARKET__FEED=rest
TRADEFIX_MARKET__REST_BASE_URL=
TRADEFIX_MARKET__REST_API_KEY=

# --- Generation provider (§18, ADR-02/ADR-04)
# mock | ace_step
TRADEFIX_GENERATION__PROVIDER=mock
# ACE-Step runs as a SEPARATE process in its own Python 3.12 / uv environment.
# Start it with `uv run acestep-api` inside the ACE-Step checkout.
TRADEFIX_GENERATION__ACE_STEP__BASE_URL=http://127.0.0.1:8001
TRADEFIX_GENERATION__ACE_STEP__DIT_MODEL=acestep-v15-turbo
TRADEFIX_GENERATION__ACE_STEP__LM_MODEL=acestep-5Hz-lm-0.6B
TRADEFIX_GENERATION__ACE_STEP__TIMEOUT_SECONDS=300

# --- Audio output (ADR-06)
# sounddevice | null_sink | wav_file
TRADEFIX_AUDIO__SINK=null_sink
# Substring match against the output device name. VB-Audio Virtual Cable routes
# cleanly into OBS without capturing desktop audio.
TRADEFIX_AUDIO__DEVICE_NAME=CABLE Input

# --- OBS (§51) — password is a SECRET
TRADEFIX_OBS__ENABLED=false
TRADEFIX_OBS__HOST=127.0.0.1
TRADEFIX_OBS__PORT=4455
TRADEFIX_OBS__PASSWORD=

# --- API
TRADEFIX_API__HOST=127.0.0.1
TRADEFIX_API__PORT=8080
# Shared secret required by state-changing control endpoints (§68). Generate a
# long random value. Leave blank ONLY when bound to 127.0.0.1 in development.
TRADEFIX_API__CONTROL_TOKEN=

# --- Logging (§55)
TRADEFIX_LOGGING__LEVEL=INFO
# json | console
TRADEFIX_LOGGING__CONSOLE_FORMAT=console
